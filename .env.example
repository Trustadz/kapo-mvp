# Kapo environment template.
#
# Local development only: copy to .env.local (Next.js loads it; all values
# optional). Docker Compose does not read this file; its settings are in
# docker-compose.yaml. Never commit .env/.env.local; they are gitignored.

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# SQLite database file (default: ./data/kapo.db)
DATABASE_PATH=./data/kapo.db

# Uploaded profile pictures (default: ./upload)
UPLOAD_DIR=./upload

# Sessions are random database-backed tokens, so no secret is required.
# When PocketID SSO is enabled, set this to keep the short-lived OIDC state
# cookie valid across restarts (a random per-process key is used otherwise).
# SESSION_SECRET=

# Absolute public URL used for metadata/manifest links.
# KAPO_PUBLIC_URL=https://kapo.example.com

# Extra host names/IPs allowed to open the dev server (comma-separated).
# `next dev` rejects the HMR websocket for origins it does not know, and a page
# whose HMR connection failed does not hydrate -- forms then submit natively.
# Entries are hostnames only (no scheme or port). `*` matches one label, so
# `192.168.1.*` covers a whole /24; `**` matches one or more leading labels.
# Example: the VM's own IP plus any host/LAN address you browse through.
# KAPO_DEV_ORIGINS=192.168.122.108,192.168.1.*

# Force the Secure flag on the session cookie when TLS terminates upstream and
# the X-Forwarded-Proto header is not set.
# KAPO_FORCE_SECURE_COOKIES=1

# ---------------------------------------------------------------------------
# PocketID / OpenID Connect SSO (optional)
# ---------------------------------------------------------------------------
# Configure these on the Kapo container, not in the database. The client
# secret therefore never appears in SQLite or its backups.
#
# Create a confidential OIDC client in PocketID with the callback URL
# <KAPO_PUBLIC_URL>/api/auth/pocketid/callback and scopes
# "openid profile email".
#
# KAPO_OIDC_ISSUER=https://id.example.com
# KAPO_OIDC_CLIENT_ID=kapo
# KAPO_OIDC_CLIENT_SECRET=
# KAPO_OIDC_SCOPES=openid profile email
# KAPO_OIDC_PROVIDER_NAME=PocketID
# Existing accounts are matched by email; unmatched emails become Viewers.
# Set to 0 to refuse new accounts instead.
# KAPO_OIDC_AUTO_PROVISION=1
# Local HTTP testing only. PocketID should use HTTPS in production.
# KAPO_OIDC_ALLOW_INSECURE=0
# Set to "disabled" to hide and reject password sign-in. Ignored (password
# login stays enabled) when OIDC is not configured, to prevent lockout.
# KAPO_PASSWORD_LOGIN=disabled

# Directory containing the SQL migration files (Docker sets this automatically).
# KAPO_MIGRATIONS_DIR=./src/server/db/migrations

# Daily rolling backup destination for local development (default: ./data/backups).
# KAPO_BACKUP_DIR=./data/backups

# Timezone used for the backup schedule and backup folder names (IANA name).
# TZ=Europe/Amsterdam
