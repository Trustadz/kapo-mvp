# Kapo environment template.
#
# Local development: copy to .env.local (Next.js loads it; all values optional).
# Docker Compose: copy to .env (Compose reads it) and edit the production values
# in the "Production / Docker Compose" section below. Never commit .env; it is
# gitignored.

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# SQLite database file (default: ./data/kapo.db)
DATABASE_PATH=./data/kapo.db

# Uploaded profile pictures (default: ./data/uploads)
UPLOAD_DIR=./data/uploads

# Sessions are random database-backed tokens, so no secret is required.
# Set this only if a future feature needs one.
# SESSION_SECRET=

# Absolute public URL used for metadata/manifest links.
# KAPO_PUBLIC_URL=https://kapo.example.com

# Force the Secure flag on the session cookie when TLS terminates upstream and
# the X-Forwarded-Proto header is not set.
# KAPO_FORCE_SECURE_COOKIES=1

# Directory containing the SQL migration files (Docker sets this automatically).
# KAPO_MIGRATIONS_DIR=./src/server/db/migrations

# Disable the automatic trash purge (startup + every 6 hours).
# KAPO_DISABLE_PURGE=1

# Daily rolling backup destination for local development (default: ./data/backups).
# KAPO_BACKUP_DIR=./data/backups

# Timezone used for the backup schedule and backup folder names (IANA name).
# TZ=Europe/Amsterdam

# ---------------------------------------------------------------------------
# Production / Docker Compose
# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values below. There are no secrets to
# configure: sessions are random database-backed tokens.

# Interface and host port published by Compose (the container always listens on
# 3000). The default binds to localhost only, for a Caddy/nginx/Traefik reverse
# proxy on the same host. Set KAPO_BIND=0.0.0.0 only for direct LAN access with
# no proxy in front of Kapo.
# KAPO_BIND=127.0.0.1
# KAPO_PORT=3000

# Prebuilt image from GitHub Container Registry (published on every push to
# main). Override the base image or tag only if you mirror the image or pin a
# release. `docker compose pull` fetches this; `docker compose up --build`
# builds locally instead.
# KAPO_IMAGE=ghcr.io/trustadz/kapo-mvp
# KAPO_IMAGE_TAG=latest

# Public URL users type in the browser. Set the https:// URL behind your TLS
# reverse proxy (Caddy, nginx, Traefik); do not include a trailing slash.
# KAPO_PUBLIC_URL=https://kapo.example.com

# Server timezone. The default daily backup runs at 02:00 in this timezone, and
# backup folder names use local time. Use a valid IANA zone.
# TZ=Europe/Amsterdam

# Only needed when the app does not receive X-Forwarded-Proto: https from your
# reverse proxy. Keep it unset for plain-HTTP local testing.
# KAPO_FORCE_SECURE_COOKIES=1

# Set to 1 to disable the automatic 6-hourly trash purge (backups keep running).
# KAPO_DISABLE_PURGE=1

# Internal/app-only values (do not set these for Compose): DATABASE_PATH,
# UPLOAD_DIR, KAPO_BACKUP_DIR and KAPO_MIGRATIONS_DIR are set explicitly by
# docker-compose.yaml. Backups live in the host `./backup` folder.
