{
  "name": "kapo",
  "version": "0.3.0",
  "private": true,
  "description": "Kapo — self-hosted household task and project management platform",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:purge": "tsx scripts/purge.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "better-sqlite3": "^13.2.0",
    "material-symbols": "^0.39.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
